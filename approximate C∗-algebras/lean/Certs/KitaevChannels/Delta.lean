import Certs.KitaevChannels.Design

/-!
# Kitaev's `Δ' (X) = ∑ₛ pₛ Φ(Δ̃(X uₛ†) Δ̃(uₛ))` and the UCP map `Δ = c Δ'(·) c`

Complete positivity of `Δ'` is the diagonal identity (`diag_block`); the estimate
`‖Δ' - Δ̃‖_cb = O(η)` uses `‖Φ - Φ̃‖_cb ≤ 12η`, (12.27) and `∑ₛ pₛ = 1`, `uₛ† uₛ = 1`.
-/

open scoped ComplexOrder

set_option linter.unusedSectionVars false

noncomputable section

namespace Cert.KitaevChannels

theorem smul_nonneg_real {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]
    {M : A} (hM : 0 ≤ M) {r : ℝ} (hr : 0 ≤ r) : 0 ≤ (r : ℂ) • M := by
  have e : (r : ℂ) • M = star ((Real.sqrt r : ℂ) • (1 : A)) * M * ((Real.sqrt r : ℂ) • (1 : A)) := by
    rw [star_smul, star_one, RCLike.star_def, Complex.conj_ofReal, smul_mul_assoc, one_mul,
      mul_smul_comm, mul_one, smul_smul, ← Complex.ofReal_mul, Real.mul_self_sqrt hr]
  rw [e]; exact star_left_conjugate_nonneg hM _

variable {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]
  {m : ℕ} {d : Fin m → ℕ}

/-- Kitaev's `Δ'`. -/
def DeltaP (Φ : (H →L[ℂ] H) →L[ℂ] (H →L[ℂ] H)) (v : BlockAlg d →ₗ[ℂ] (H →L[ℂ] H))
    (D : (j : Fin m) → Design (d j)) : BlockAlg d →ₗ[ℂ] (H →L[ℂ] H) :=
  ∑ s, (pg D s : ℂ) • (Φ.toLinearMap ∘ₗ LinearMap.mulRight ℂ (v (ug D s)) ∘ₗ v ∘ₗ
    LinearMap.mulRight ℂ (star (ug D s)))

theorem DeltaP_apply (Φ : (H →L[ℂ] H) →L[ℂ] (H →L[ℂ] H)) (v : BlockAlg d →ₗ[ℂ] (H →L[ℂ] H))
    (D : (j : Fin m) → Design (d j)) (x : BlockAlg d) :
    DeltaP Φ v D x = ∑ s, (pg D s : ℂ) • Φ (v (x * star (ug D s)) * v (ug D s)) := by
  simp [DeltaP]

theorem cm_sum_apply {M : Type*} [AddCommMonoid M] {n : ℕ} {ι : Type*} (t : Finset ι)
    (f : ι → Mat n M) (k l : Fin n) : (∑ i ∈ t, f i) k l = ∑ i ∈ t, f i k l :=
  Matrix.sum_apply k l t f

theorem cm_smul_apply {M : Type*} [AddCommMonoid M] [Module ℂ M] {n : ℕ} (c : ℂ) (X : Mat n M)
    (k l : Fin n) : (c • X) k l = c • X k l := rfl

/-- `Δ'ₙ(Y†Y) = ∑ₛ pₛ Φₙ(Zₛ† Zₛ)` with `Zₛ = Δ̃ₙ(diag(uₛ) Y)`, hence `Δ'ₙ(Y†Y) ≥ 0`. -/
theorem DeltaP_cp_aux {Φ : (H →L[ℂ] H) →L[ℂ] (H →L[ℂ] H)} (hΦ : IsCP Φ.toLinearMap)
    {v : BlockAlg d →ₗ[ℂ] (H →L[ℂ] H)} (hvs : ∀ b, v (star b) = star (v b))
    (D : (j : Fin m) → Design (d j)) {n : ℕ} (Y : Mat n (BlockAlg d)) :
    0 ≤ (star Y * Y).map (DeltaP Φ v D) := by
  let β : BlockAlg d →ₗ[ℂ] BlockAlg d →ₗ[ℂ] (H →L[ℂ] H) :=
    ((LinearMap.mul ℂ (H →L[ℂ] H)).compl₁₂ v v).compr₂ Φ.toLinearMap
  have hβ : ∀ p q, β p q = Φ (v p * v q) := fun _ _ => rfl
  let Z : GIdx D → Mat n (H →L[ℂ] H) := fun s => (diagM n (ug D s) * Y).map v
  have hZ : ∀ s t k, Z s t k = v (ug D s * Y t k) := fun s t k => by
    simp only [Z, amp_apply, diagM_mul_left]
  have key : (star Y * Y).map (DeltaP Φ v D) =
      ∑ s, (pg D s : ℂ) • (star (Z s) * Z s).map Φ.toLinearMap := by
    refine CStarMatrix.ext fun k l => ?_
    rw [amp_apply, DeltaP_apply, cm_sum_apply]
    have hXkl : (star Y * Y) k l = ∑ t, star (Y t k) * Y t l := by
      rw [CStarMatrix.mul_apply]
      exact Finset.sum_congr rfl fun t _ => by rw [CStarMatrix.star_apply]
    have lhs : ∀ s, Φ (v ((star Y * Y) k l * star (ug D s)) * v (ug D s)) =
        ∑ t, β (star (Y t k) * Y t l * star (ug D s)) (ug D s) := fun s => by
      rw [hXkl, Finset.sum_mul, map_sum, Finset.sum_mul, map_sum]
      rfl
    have rhs : ∀ s, ((pg D s : ℂ) • (star (Z s) * Z s).map Φ.toLinearMap) k l =
        (pg D s : ℂ) • ∑ t, β (star (Y t k) * star (ug D s)) (ug D s * Y t l) := fun s => by
      rw [cm_smul_apply, amp_apply, CStarMatrix.mul_apply, map_sum]
      refine congrArg _ (Finset.sum_congr rfl fun t _ => ?_)
      rw [CStarMatrix.star_apply, hZ, hZ, hβ, ← hvs, star_mul]
      rfl
    simp only [lhs, rhs, Finset.smul_sum]
    rw [Finset.sum_comm, Finset.sum_comm (f := fun s t => (pg D s : ℂ) •
      β (star (Y t k) * star (ug D s)) (ug D s * Y t l))]
    exact Finset.sum_congr rfl fun t _ => diag_block D β (star (Y t k)) (Y t l)
  rw [key]
  exact Finset.sum_nonneg fun s _ =>
    smul_nonneg_real (hΦ n _ (star_mul_self_nonneg _)) (pg_nonneg D s)

/-- **Δ' is completely positive** (Kitaev §12.2): positive matrices are generated by `Y†Y`. -/
theorem DeltaP_cp {Φ : (H →L[ℂ] H) →L[ℂ] (H →L[ℂ] H)} (hΦ : IsCP Φ.toLinearMap)
    {v : BlockAlg d →ₗ[ℂ] (H →L[ℂ] H)} (hvs : ∀ b, v (star b) = star (v b))
    (D : (j : Fin m) → Design (d j)) : IsCP (DeltaP Φ v D) := by
  intro n X hX
  rw [StarOrderedRing.nonneg_iff] at hX
  induction hX using AddSubmonoid.closure_induction with
  | mem x hx => obtain ⟨Y, rfl⟩ := hx; exact DeltaP_cp_aux hΦ hvs D Y
  | zero => rw [show (0 : Mat n (BlockAlg d)).map (DeltaP Φ v D) = 0 by
      exact CStarMatrix.ext fun i j => map_zero (DeltaP Φ v D)]
  | add x y _ _ hx hy => rw [amp_add]; exact add_nonneg hx hy

theorem norm_le_one_of_star_mul_self {A : Type*} [CStarAlgebra A] {u : A}
    (h : star u * u = 1) : ‖u‖ ≤ 1 := by
  have h1 : ‖(1 : A)‖ ≤ 1 := by
    have := CStarRing.norm_star_mul_self (x := (1 : A))
    rw [star_one, one_mul] at this
    nlinarith [norm_nonneg (1 : A)]
  have := CStarRing.norm_star_mul_self (x := u)
  rw [h] at this
  nlinarith [norm_nonneg u]

theorem diagM_mul {A : Type*} [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A] (n : ℕ)
    (a b : A) : diagM n a * diagM n b = diagM n (a * b) := by
  refine CStarMatrix.ext fun i j => ?_
  rw [diagM_mul_left, diagM_apply, diagM_apply]
  split_ifs <;> simp

section Estimate

variable [Nontrivial H] (hF : CPMapFacts) {Φ : (H →L[ℂ] H) →L[ℂ] (H →L[ℂ] H)} {η δ : ℝ}
  {v : BlockAlg d →ₗ[ℂ] (H →L[ℂ] H)}
  (hv : IsExtDeltaIsoOnto δ (LinearMap.range (tildePhi Φ).toLinearMap) (choiEffros Φ) v)
  (D : (j : Fin m) → Design (d j))
include hF hv

set_option maxHeartbeats 2000000 in
theorem DeltaP_sub_cb (hΦ : IsUCP Φ.toLinearMap) (hcb : CBBound (Φ * Φ - Φ).toLinearMap η)
    (hη : 0 ≤ η) (hη8 : η ≤ 1 / 8) (hδ : 0 ≤ δ) :
    CBBound (DeltaP Φ v D - v) (12 * η * (1 + δ) ^ 2 + δ) := by
  intro n X
  have hT := tildePhi_sub_cb hF hΦ hcb hη hη8
  set K := 12 * η * (1 + δ) ^ 2 + δ with hK
  let Ds : GIdx D → Mat n (BlockAlg d) := fun s => diagM n (ug D s)
  let Ps : GIdx D → Mat n (BlockAlg d) := fun s => X * diagM n (star (ug D s))
  let Rs : GIdx D → Mat n (H →L[ℂ] H) := fun s => (Ps s).map v * (Ds s).map v
  have hA : X.map (DeltaP Φ v D) = ∑ s, (pg D s : ℂ) • (Rs s).map Φ.toLinearMap := by
    refine CStarMatrix.ext fun k l => ?_
    rw [amp_apply, DeltaP_apply, cm_sum_apply]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [cm_smul_apply, amp_apply]
    have hR : Rs s k l = v (X k l * star (ug D s)) * v (ug D s) := by
      simp only [Rs, Ds, Ps]
      rw [amp_diagM, mul_diagM_right, amp_apply, mul_diagM_right]
    rw [hR]
    rfl
  have hB : X.map v = ∑ s, (pg D s : ℂ) • (Ps s * Ds s).map v := by
    have e : ∀ s, Ps s * Ds s = X := fun s => by
      simp only [Ps, Ds, mul_assoc, diagM_mul, (ug_unitary D s).1]
      rw [show diagM n (1 : BlockAlg d) = 1 from map_one (diagHom (M₂ := BlockAlg d) n), mul_one]
    simp only [e]
    rw [← Finset.sum_smul, ← Complex.ofReal_sum, pg_sum, Complex.ofReal_one, one_smul]
  rw [amp_sub_fun, hA, hB, ← Finset.sum_sub_distrib]
  have hterm : ∀ s, ‖(pg D s : ℂ) • (Rs s).map Φ.toLinearMap - (pg D s : ℂ) • (Ps s * Ds s).map v‖
      ≤ pg D s * (K * ‖X‖) := fun s => by
    rw [← smul_sub, norm_smul, Complex.norm_real, Real.norm_of_nonneg (pg_nonneg D s)]
    gcongr
    · exact pg_nonneg D s
    have hu : ‖ug D s‖ ≤ 1 := norm_le_one_of_star_mul_self (ug_unitary D s).1
    have hus : ‖star (ug D s)‖ ≤ 1 :=
      norm_le_one_of_star_mul_self (by rw [star_star]; exact (ug_unitary D s).2)
    have hD : ‖Ds s‖ ≤ 1 := (norm_diagM_le n _).trans hu
    have hP : ‖Ps s‖ ≤ ‖X‖ := by
      have h := norm_mul_le X (diagM n (star (ug D s)))
      have h' := (norm_diagM_le n (star (ug D s))).trans hus
      have hX := norm_nonneg X
      nlinarith
    have hR : ‖Rs s‖ ≤ (1 + δ) ^ 2 * ‖X‖ := by
      have h0 : ‖Rs s‖ ≤ ‖(Ps s).map v‖ * ‖(Ds s).map v‖ := norm_mul_le _ _
      have ha : ‖(Ps s).map v‖ ≤ (1 + δ) * ‖Ps s‖ := v_cb hv n _
      have hb : ‖(Ds s).map v‖ ≤ (1 + δ) * ‖Ds s‖ := v_cb hv n _
      have ha0 := norm_nonneg ((Ps s).map v)
      have hb0 := norm_nonneg ((Ds s).map v)
      have hPn := norm_nonneg (Ps s)
      have hDn := norm_nonneg (Ds s)
      have hXn := norm_nonneg X
      generalize ‖Rs s‖ = r at h0 ⊢
      generalize ‖(Ps s).map v‖ = a at h0 ha ha0
      generalize ‖(Ds s).map v‖ = b at h0 hb hb0
      generalize ‖Ps s‖ = P at ha hP hPn
      generalize ‖Ds s‖ = Q at hb hD hDn
      generalize ‖X‖ = x at hP hXn ⊢
      have h1δ : 0 ≤ 1 + δ := by linarith
      have hab : a * b ≤ ((1 + δ) * P) * ((1 + δ) * Q) := mul_le_mul ha hb hb0 (by positivity)
      have hPQ : ((1 + δ) * P) * ((1 + δ) * Q) ≤ ((1 + δ) * x) * ((1 + δ) * 1) :=
        mul_le_mul (by nlinarith) (by nlinarith) (by positivity) (by positivity)
      nlinarith
    have h1 : ‖(Rs s).map Φ.toLinearMap - (Rs s).map (tildePhi Φ).toLinearMap‖ ≤ 12 * η * ‖Rs s‖ := by
      have := hT n (Rs s)
      rw [amp_sub_fun] at this
      rw [norm_sub_rev]; exact this
    have h2 : ‖(Rs s).map (tildePhi Φ).toLinearMap - (Ps s * Ds s).map v‖ ≤ δ * ‖Ps s‖ * ‖Ds s‖ :=
      v_mul hv (Ps s) (Ds s)
    calc ‖(Rs s).map Φ.toLinearMap - (Ps s * Ds s).map v‖
        ≤ ‖(Rs s).map Φ.toLinearMap - (Rs s).map (tildePhi Φ).toLinearMap‖
          + ‖(Rs s).map (tildePhi Φ).toLinearMap - (Ps s * Ds s).map v‖ := norm_sub_le_norm_sub_add_norm_sub _ _ _
      _ ≤ 12 * η * ‖Rs s‖ + δ * ‖Ps s‖ * ‖Ds s‖ := add_le_add h1 h2
      _ ≤ 12 * η * ((1 + δ) ^ 2 * ‖X‖) + δ * ‖X‖ * 1 := by
          have hPn := norm_nonneg (Ps s)
          have hXn := norm_nonneg X
          have hDn := norm_nonneg (Ds s)
          have e1 : 12 * η * ‖Rs s‖ ≤ 12 * η * ((1 + δ) ^ 2 * ‖X‖) :=
            mul_le_mul_of_nonneg_left hR (by positivity)
          have e2 : δ * ‖Ps s‖ * ‖Ds s‖ ≤ δ * ‖X‖ * 1 :=
            mul_le_mul (mul_le_mul_of_nonneg_left hP hδ) hD hDn (mul_nonneg hδ hXn)
          linarith
      _ = K * ‖X‖ := by rw [hK]; ring
  calc ‖∑ s, ((pg D s : ℂ) • (Rs s).map Φ.toLinearMap - (pg D s : ℂ) • (Ps s * Ds s).map v)‖
      ≤ ∑ s, ‖(pg D s : ℂ) • (Rs s).map Φ.toLinearMap - (pg D s : ℂ) • (Ps s * Ds s).map v‖ :=
        norm_sum_le _ _
    _ ≤ ∑ s, pg D s * (K * ‖X‖) := Finset.sum_le_sum fun s _ => hterm s
    _ = K * ‖X‖ := by rw [← Finset.sum_mul, pg_sum, one_mul]

end Estimate

end Cert.KitaevChannels
